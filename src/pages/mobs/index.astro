---
import WikiLayout from '../../layouts/WikiLayout.astro';
import LoreCard from '../../components/ui/LoreCard.astro';
import { db } from '../../lib/firebase-admin';
import type { MobEntity } from '../../lib/types';

// Fetch all mobs
const snapshot = await db.collection('mobs').get();
const allMobs: MobEntity[] = snapshot.docs.map((doc: any) => ({
  id: doc.id,
  type: 'mob',
  ...doc.data()
} as MobEntity));

// Sort by Threat Tier (logic: S > A > B > C > D)
const tierOrder: Record<string, number> = { 'S': 0, 'A': 1, 'B': 2, 'C': 3, 'D': 4, 'Unknown': 5 };
const sortedMobs = [...allMobs].sort((a, b) => {
  const tierA = a.threatTier || 'Unknown';
  const tierB = b.threatTier || 'Unknown';
  return (tierOrder[tierA] ?? 5) - (tierOrder[tierB] ?? 5);
});
---

<WikiLayout title="Ancient Bestiary" category="Bestiary">
  <div class="bestiary-hub">
    <!-- Tier Summary Section -->
    <section class="tier-nav glass-card">
      <div class="tier-row">
        {['S', 'A', 'B', 'C', 'D'].map(tier => (
          <div class="tier-indicator">
            <span class={`tier-label tier-${tier}`}>{tier}</span>
            <span class="tier-count">
              {allMobs.filter(m => m.threatTier === tier).length} DISCOVERIES
            </span>
          </div>
        ))}
      </div>
    </section>

    <!-- Mobs Gallery -->
    <div class="mobs-gallery">
      {sortedMobs.length > 0 ? (
        sortedMobs.map(mob => {
          const tagArray = typeof mob.tags === 'string' 
            ? mob.tags.split(',').map((t: string) => t.trim()).filter(Boolean)
            : (Array.isArray(mob.tags) ? mob.tags.filter((t): t is string => typeof t === 'string') : []);

          return (
            <LoreCard 
              id={mob.id}
              type="mob"
              name={mob.name || 'Unknown Beast'}
              description={mob.loreDescription || 'No observations recorded in the Bestiary.'}
              imageUrl={mob.imageUrl}
              tags={tagArray}
            />
          );
        })
      ) : (
        <div class="empty-state glass-card">
          <p>The bestiary archives are currently silent of terrors.</p>
          <a href="/creator-dashboard" class="btn-primary">Bind First Discovery at The Forge</a>
        </div>
      )}
    </div>
  </div>
</WikiLayout>

<style>
  .bestiary-hub {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .tier-nav {
    padding: 1.5rem 3rem;
    border-radius: 16px;
  }

  .tier-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .tier-indicator {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .tier-label {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    font-weight: 900;
    font-size: 1.2rem;
    font-family: var(--font-display);
    border: 1px solid var(--glass-border);
  }

  .tier-S { background: rgba(185, 28, 28, 0.1); color: #b91c1c; border-color: #b91c1c; box-shadow: 0 0 15px rgba(185, 28, 28, 0.2); }
  .tier-A { background: rgba(217, 119, 6, 0.1); color: #d97706; border-color: #d97706; }
  .tier-B { background: rgba(212, 175, 55, 0.1); color: #d4af37; border-color: #d4af37; }
  .tier-C { background: rgba(58, 95, 11, 0.1); color: #3a5f0b; border-color: #3a5f0b; }
  .tier-D { background: rgba(27, 58, 75, 0.1); color: #1b3a4b; border-color: #1b3a4b; }

  .tier-count {
    font-size: 0.75rem;
    color: var(--text-tertiary);
    font-family: monospace;
    letter-spacing: 0.1em;
  }

  .mobs-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2.5rem;
  }

  .empty-state {
    grid-column: 1 / -1;
    text-align: center;
    padding: 6rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .tier-row {
      justify-content: center;
    }
  }
</style>
