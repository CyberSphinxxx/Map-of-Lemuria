---
import WikiLayout from '../layouts/WikiLayout.astro';
import { Sparkles, ShieldCheck } from '@lucide/astro';

const reason = Astro.url.searchParams.get('reason');
let message = '';
if (reason === 'unauthenticated') message = 'Entry to the Forge requires ritual authentication.';
if (reason === 'invalid-session') message = 'Your connection to the Archives has faded. Please re-authenticate.';
if (reason === 'non-admin') message = 'Only established Archive Guardians may enter the Forge.';
if (reason === 'no-session') message = 'The Archives require a session to be established.';
---

<WikiLayout title="Archive Access">
  <div class="login-container">
    <div class="login-card glass-card">
      <header class="login-header">
        <div class="shield-icon"><ShieldCheck size={48} /></div>
        <h2 class="glow-text">Loreweaver Protocol</h2>
        <p class="description">Consult the ancient spirits to verify your identity.</p>
      </header>

      {message && <div class="auth-message">{message}</div>}

      <div class="auth-box">
        <div class="input-group">
          <label for="email">Email</label>
          <input type="email" id="email" placeholder="weaver@lemuria.realm" />
        </div>
        <div class="input-group">
          <label for="password">Key</label>
          <input type="password" id="password" placeholder="••••••••" />
        </div>
        
        <button id="login-btn" class="btn-primary login-btn">
          <Sparkles size={18} class="icon" /> Verify Identity
        </button>

        <div class="divider">
          <span>OR</span>
        </div>

        <button id="google-login-btn" class="btn-secondary google-btn">
          <svg viewBox="0 0 24 24" width="18" height="18" class="icon">
            <path fill="currentColor" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
            <path fill="currentColor" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
            <path fill="currentColor" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" />
            <path fill="currentColor" d="M12 5.38c1.62 0 3.06.56 4.21 1.66l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" />
          </svg>
          Chrono-Link (Google)
        </button>
      </div>

      <div id="auth-error" class="auth-error hidden"></div>
      
      <footer class="login-footer">
        <p>Access is restricted to established Chronos Scouts and Archive Guardians.</p>
      </footer>
    </div>
  </div>
</WikiLayout>

<script>
  import { auth } from '../lib/firebase-client';
  import { signInWithEmailAndPassword, GoogleAuthProvider, signInWithPopup } from 'firebase/auth';

  const loginBtn = document.getElementById('login-btn');
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const passwordInput = document.getElementById('password') as HTMLInputElement;
  const errorEl = document.getElementById('auth-error');

  const googleLoginBtn = document.getElementById('google-login-btn');

  const handleSuccessfulAuth = async (user: any) => {
    const idToken = await user.getIdToken();
    // Set cookie for middleware access
    document.cookie = `__session=${idToken}; Path=/; SameSite=Strict; Max-Age=3600; Secure`;
    // Redirect to dashboard
    window.location.href = '/creator-dashboard';
  };

  loginBtn?.addEventListener('click', async () => {
    if (!emailInput || !passwordInput || !loginBtn) return;

    const email = emailInput.value;
    const password = passwordInput.value;

    if (!email || !password) {
      showError('Please provide both email and ritual key.');
      return;
    }

    loginBtn.innerText = 'Verifying...';
    loginBtn.setAttribute('disabled', 'true');
    errorEl?.classList.add('hidden');

    try {
      const userCredential = await signInWithEmailAndPassword(auth, email, password);
      await handleSuccessfulAuth(userCredential.user);
    } catch (err: any) {
      console.error('Auth failure:', err);
      showError(err.message || 'The spirits rejected your credentials.');
      loginBtn.innerText = 'Verify Identity';
      loginBtn.removeAttribute('disabled');
    }
  });

  googleLoginBtn?.addEventListener('click', async () => {
    const provider = new GoogleAuthProvider();
    googleLoginBtn.setAttribute('disabled', 'true');
    const originalText = googleLoginBtn.innerText;
    googleLoginBtn.innerText = 'Summoning Google...';
    errorEl?.classList.add('hidden');

    try {
      const result = await signInWithPopup(auth, provider);
      await handleSuccessfulAuth(result.user);
    } catch (err: any) {
      console.error('Google Auth failure:', err);
      showError(err.message || 'Chrono-Link failed. The connection was interrupted.');
      googleLoginBtn.innerText = originalText;
      googleLoginBtn.removeAttribute('disabled');
    }
  });

  function showError(msg: string) {
    if (!errorEl) return;
    errorEl.innerText = msg;
    errorEl.classList.remove('hidden');
  }
</script>

<style>
  .login-container {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 6rem 0;
  }

  .login-card {
    width: 100%;
    max-width: 450px;
    padding: 3rem;
    text-align: center;
  }

  .login-header {
    margin-bottom: 2.5rem;
  }

  .shield-icon {
    color: var(--accent-primary);
    margin-bottom: 1.5rem;
    filter: drop-shadow(0 0 10px rgba(139, 92, 246, 0.5));
  }

  .login-header h2 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  .description {
    color: var(--text-tertiary);
    font-size: 0.9rem;
  }

  .auth-message {
    background: rgba(139, 92, 246, 0.1);
    border: 1px solid rgba(139, 92, 246, 0.2);
    padding: 0.75rem;
    border-radius: 8px;
    color: var(--accent-primary);
    font-size: 0.85rem;
    margin-bottom: 2rem;
  }

  .auth-box {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    text-align: left;
  }

  .input-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .input-group label {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .input-group input {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--glass-border);
    padding: 0.8rem 1rem;
    border-radius: 8px;
    color: var(--text-primary);
    outline: none;
    transition: var(--transition-smooth);
  }

  .input-group input:focus {
    border-color: var(--accent-primary);
    box-shadow: 0 0 0 2px rgba(139, 92, 246, 0.2);
  }

  .login-btn {
    width: 100%;
    padding: 1rem;
    margin-top: 1rem;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .divider {
    display: flex;
    align-items: center;
    text-align: center;
    margin: 1.5rem 0;
    color: var(--text-tertiary);
    font-size: 0.75rem;
    font-weight: 500;
  }

  .divider::before,
  .divider::after {
    content: '';
    flex: 1;
    border-bottom: 1px solid var(--glass-border);
  }

  .divider span {
    padding: 0 1rem;
  }

  .google-btn {
    width: 100%;
    padding: 1rem;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--glass-border);
    color: var(--text-primary);
  }

  .google-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: var(--accent-primary);
  }

  .google-btn .icon {
    opacity: 0.8;
  }

  .auth-error {
    margin-top: 1.5rem;
    color: #ef4444;
    font-size: 0.85rem;
    background: rgba(239, 68, 68, 0.1);
    padding: 0.75rem;
    border-radius: 8px;
    border: 1px solid rgba(239, 68, 68, 0.2);
  }

  .login-footer {
    margin-top: 3rem;
    font-size: 0.75rem;
    color: var(--text-tertiary);
    line-height: 1.5;
  }

  .hidden {
    display: none;
  }
</style>
