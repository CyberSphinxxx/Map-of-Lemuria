---
import WikiLayout from '../layouts/WikiLayout.astro';
import { t, type LanguageStyle } from '../lib/i18n';
import { User, Shield, Palette, Zap, Trash2, LogOut, Settings as SettingsIcon, Globe } from '@lucide/astro';

const user = Astro.locals.user;
const rawStyle = Astro.locals.languageStyle;
const style = (rawStyle as LanguageStyle) || 'fantasy';
console.log('[Settings] Current style:', style);
const strings = t(style);
---

<WikiLayout title={strings.settings.title} category={strings.sidebar.system}>
  <div class="settings-container">
    <header class="settings-header">
      <h1 class="glow-text">{strings.settings.title}</h1>
      <p class="description">{strings.settings.description}</p>
    </header>

    <div class="settings-grid">
      <!-- Account Section -->
      <section class="settings-card glass-card">
        <div class="card-header">
          <!-- <User class="icon" /> -->
          <h2>{strings.settings.account}</h2>
        </div>
        <div class="card-body">
          {user ? (
            <div class="user-profile">
              <div class="avatar-wrapper">
                {user.picture ? (
                  <img src={user.picture} alt={user.name || 'User'} class="avatar" />
                ) : (
                  <div class="avatar-placeholder">{(user.name || user.email || 'G').charAt(0)}</div>
                )}
              </div>
              <div class="user-info">
                <p class="user-name">{user.name || (style === 'fantasy' ? 'Anonymous Guardian' : 'Anonymous User')}</p>
                <p class="user-email">{user.email}</p>
                <span class="badge admin-badge">{style === 'fantasy' ? 'Archive Admin' : 'Admin'}</span>
              </div>
            </div>
          ) : (
            <div class="empty-state">
              <p>{style === 'fantasy' ? 'No active link to the identity archives found.' : 'You are not signed in.'}</p>
              <a href="/login" class="btn-primary">{style === 'fantasy' ? 'Link Identity' : 'Sign In'}</a>
            </div>
          )}
        </div>
      </section>

      <!-- Appearance Section -->
      <section class="settings-card glass-card">
        <div class="card-header">
          <Palette class="icon" />
          <h2>{strings.settings.appearance}</h2>
        </div>
        <div class="card-body">
          <div class="setting-item">
            <div class="setting-info">
              <h3>{strings.settings.theme}</h3>
              <p>{strings.settings.themeDesc}</p>
            </div>
            <div class="theme-options">
              <button class="theme-btn" data-theme="dark">Dark</button>
              <button class="theme-btn" data-theme="light">Light</button>
              <button class="theme-btn" data-theme="system">System</button>
            </div>
          </div>
          <div class="setting-item">
            <div class="setting-info">
              <h3>{strings.settings.langStyle}</h3>
              <p>{strings.settings.langStyleDesc}</p>
            </div>
            <div class="style-options">
              <button class="style-btn" data-style="fantasy">{strings.settings.fantasyLabel}</button>
              <button class="style-btn" data-style="standard">{strings.settings.standardLabel}</button>
            </div>
          </div>
        </div>
      </section>

      <!-- Preferences Section -->
      <section class="settings-card glass-card">
        <div class="card-header">
          <Zap class="icon" />
          <h2>{strings.settings.preferences}</h2>
        </div>
        <div class="card-body">
          <div class="setting-item">
            <div class="setting-info">
              <h3>{strings.settings.density}</h3>
              <p>{strings.settings.densityDesc}</p>
            </div>
            <label class="switch">
              <input type="checkbox" id="density-toggle" />
              <span class="slider"></span>
            </label>
          </div>
          <div class="setting-item">
            <div class="setting-info">
              <h3>{strings.settings.ai}</h3>
              <p>{strings.settings.aiDesc}</p>
            </div>
            <label class="switch">
              <input type="checkbox" id="chat-toggle" checked />
              <span class="slider"></span>
            </label>
          </div>
        </div>
      </section>

      <!-- Danger Zone -->
      <section class="settings-card glass-card danger-card">
        <div class="card-header">
          <Shield class="icon" />
          <h2>{strings.settings.danger}</h2>
        </div>
        <div class="card-body">
          <div class="setting-item">
            <div class="setting-info">
              <h3>{strings.settings.purge}</h3>
              <p>{strings.settings.purgeDesc}</p>
            </div>
            <button id="clear-cache-btn" class="btn-outline-danger">{strings.settings.purgeButton}</button>
          </div>
          <div class="setting-item">
            <div class="setting-info">
              <h3>{strings.settings.logoutAction}</h3>
              <p>{strings.settings.logoutDesc}</p>
            </div>
            <button id="settings-logout-btn" class="btn-danger">{strings.settings.logoutButton}</button>
          </div>
        </div>
      </section>
    </div>
  </div>
</WikiLayout>

<script>
  // Theme Management Integration
  const themeBtns = document.querySelectorAll('.theme-btn');
  const html = document.documentElement;

  const currentTheme = localStorage.getItem('lemuria-theme') || 'system';
  setActiveThemeBtn(currentTheme);

  themeBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const theme = (btn as HTMLElement).dataset.theme || 'dark';
      
      if (theme === 'system') {
        localStorage.removeItem('lemuria-theme');
        const systemTheme = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        html.setAttribute('data-theme', systemTheme);
      } else {
        html.setAttribute('data-theme', theme);
        localStorage.setItem('lemuria-theme', theme);
      }
      
      setActiveThemeBtn(theme);
      // Notify other components if necessary
      window.dispatchEvent(new Event('storage'));
    });
  });

  function setActiveThemeBtn(theme: string) {
    themeBtns.forEach(btn => {
      btn.classList.toggle('active', (btn as HTMLElement).dataset.theme === theme);
    });
  }

  // Preferences Management
  const densityToggle = document.getElementById('density-toggle') as HTMLInputElement;
  const chatToggle = document.getElementById('chat-toggle') as HTMLInputElement;

  // Load initial states
  if (densityToggle) {
    densityToggle.checked = localStorage.getItem('compact-mode') === 'true';
    densityToggle.addEventListener('change', () => {
      localStorage.setItem('compact-mode', densityToggle.checked.toString());
    });
  }

  if (chatToggle) {
    chatToggle.checked = localStorage.getItem('hide-lorekeeper') !== 'true';
    chatToggle.addEventListener('change', () => {
      localStorage.setItem('hide-lorekeeper', (!chatToggle.checked).toString());
      window.dispatchEvent(new CustomEvent('lorekeeper-visibility', { detail: chatToggle.checked }));
    });
  }

  // Logout Logic
  const logoutBtn = document.getElementById('settings-logout-btn');
  logoutBtn?.addEventListener('click', async () => {
    logoutBtn.innerText = 'DISCONNECTING...';
    await fetch('/api/logout', { method: 'POST' });
    window.location.href = '/login';
  });

  // Language Style Management
  const styleBtns = document.querySelectorAll('.style-btn');
  const currentStyle = document.cookie.split('; ').find(row => row.startsWith('lemuria-language-style='))?.split('=')[1] || 'fantasy';
  
  setActiveStyleBtn(currentStyle);

  styleBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const style = (btn as HTMLElement).dataset.style || 'fantasy';
      document.cookie = `lemuria-language-style=${style}; path=/; max-age=31536000`;
      window.location.reload();
    });
  });

  function setActiveStyleBtn(style: string) {
    styleBtns.forEach(btn => {
      btn.classList.toggle('active', (btn as HTMLElement).dataset.style === style);
    });
  }

  // Clear Cache Logic
  const clearBtn = document.getElementById('clear-cache-btn');
  clearBtn?.addEventListener('click', () => {
    if (confirm('Are you sure you want to purge local echoes (preferences)?')) {
      localStorage.clear();
      window.location.reload();
    }
  });
</script>

<style>
  .settings-container {
    max-width: 1000px;
    margin: 0 auto;
  }

  .settings-header {
    margin-bottom: 3rem;
  }

  .description {
    color: var(--text-secondary);
    font-size: 1.1rem;
    margin-top: 0.5rem;
  }

  .settings-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .settings-card {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 1rem;
  }

  .card-header .icon {
    color: var(--accent-primary);
    width: 24px;
    height: 24px;
  }

  .card-header h2 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* User Profile Styles */
  .user-profile {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .avatar-wrapper {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid var(--accent-primary);
    box-shadow: 0 0 15px var(--accent-glow);
  }

  .avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .avatar-placeholder {
    width: 100%;
    height: 100%;
    background: var(--accent-glow);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    font-weight: 700;
  }

  .user-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .user-name {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }

  .user-email {
    font-size: 0.9rem;
    color: var(--text-tertiary);
    margin: 0;
  }

  .admin-badge {
    align-self: flex-start;
    font-size: 0.65rem;
    margin-top: 0.5rem;
    padding: 0.2rem 0.6rem;
    background: rgba(139, 92, 246, 0.2);
    border: 1px solid var(--accent-primary);
    border-radius: 4px;
    color: var(--accent-primary);
    text-transform: uppercase;
    font-weight: 700;
  }

  /* Setting Items */
  .setting-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .setting-info h3 {
    font-size: 1rem;
    margin: 0;
    color: var(--text-primary);
  }

  .setting-info p {
    font-size: 0.85rem;
    color: var(--text-tertiary);
    margin: 0.25rem 0 0;
  }

  /* Theme Buttons */
  .theme-options {
    display: flex;
    gap: 0.5rem;
    background: rgba(255, 255, 255, 0.05);
    padding: 0.25rem;
    border-radius: 8px;
    border: 1px solid var(--border-color);
  }

  .theme-btn {
    background: none;
    border: none;
    color: var(--text-tertiary);
    padding: 0.4rem 0.8rem;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    transition: var(--transition-smooth);
  }

  .theme-btn:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.05);
  }

  .theme-btn.active {
    background: var(--accent-primary);
    color: white;
    box-shadow: 0 0 10px rgba(139, 92, 246, 0.3);
  }

  /* Style Buttons */
  .style-options {
    display: flex;
    gap: 0.5rem;
    background: rgba(255, 255, 255, 0.05);
    padding: 0.25rem;
    border-radius: 8px;
    border: 1px solid var(--border-color);
  }

  .style-btn {
    background: none;
    border: none;
    color: var(--text-tertiary);
    padding: 0.4rem 0.8rem;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    transition: var(--transition-smooth);
  }

  .style-btn:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.05);
  }

  .style-btn.active {
    background: var(--accent-primary);
    color: white;
    box-shadow: 0 0 10px rgba(139, 92, 246, 0.3);
  }

  /* Switch Toggle */
  .switch {
    position: relative;
    display: inline-block;
    width: 44px;
    height: 24px;
  }

  .switch input {
    opacity: 0;
    width: 0;
    height: 0;
  }

  .slider {
    position: absolute;
    cursor: pointer;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(255, 255, 255, 0.1);
    transition: .4s;
    border-radius: 24px;
    border: 1px solid var(--border-color);
  }

  .slider:before {
    position: absolute;
    content: "";
    height: 16px;
    width: 16px;
    left: 3px;
    bottom: 3px;
    background-color: var(--text-tertiary);
    transition: .4s;
    border-radius: 50%;
  }

  input:checked + .slider {
    background-color: rgba(139, 92, 246, 0.2);
    border-color: var(--accent-primary);
  }

  input:checked + .slider:before {
    transform: translateX(20px);
    background-color: var(--accent-primary);
    box-shadow: 0 0 10px var(--accent-primary);
  }

  /* Danger Zone Tweak */
  .danger-card {
    border-color: rgba(239, 68, 68, 0.2);
  }

  .danger-card .icon {
    color: #ef4444;
  }

  .btn-danger {
    background: #ef4444;
    color: white;
    border: none;
    padding: 0.6rem 1.2rem;
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.85rem;
    cursor: pointer;
    transition: var(--transition-smooth);
  }

  .btn-outline-danger {
    background: none;
    border: 1px solid rgba(239, 68, 68, 0.4);
    color: #ef4444;
    padding: 0.6rem 1.2rem;
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.85rem;
    cursor: pointer;
    transition: var(--transition-smooth);
  }

  .btn-outline-danger:hover {
    background: rgba(239, 68, 68, 0.1);
  }

  .disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .lock-tag {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    color: var(--text-tertiary);
  }

  @media (max-width: 768px) {
    .settings-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
