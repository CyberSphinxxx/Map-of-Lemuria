---
import WikiLayout from '../../layouts/WikiLayout.astro';
import LineageBuilder from '../../components/LineageBuilder';
---

<WikiLayout title="Lineage Builder">
  <div class="lineage-container">
    <header class="lineage-header">
      <p class="description">Map out the evolutions and relationships between the entities of Lemuria.</p>
    </header>

    <div class="builder-wrapper">
      <LineageBuilder client:load />
    </div>

    <div class="builder-controls glass-card">
      <h3>Mapping Protocol</h3>
      <ul>
        <li>Nodes represent entities (Mobs, Characters).</li>
        <li>Edges represent evolutionary paths or ancestral links.</li>
        <li>Dragging handles creates new relational vectors.</li>
      </ul>
    </div>
  </div>
</WikiLayout>

<style>
  .lineage-container {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .lineage-header {
    margin-bottom: 1rem;
  }

  .description {
    color: var(--text-secondary);
  }

  .builder-wrapper {
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.5);
  }

  .builder-controls {
    padding: 1.5rem;
    margin-top: 1rem;
  }

  .builder-controls h3 {
    font-size: 0.9rem;
    color: var(--accent-primary);
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .builder-controls ul {
    list-style: disc;
    padding-left: 1.5rem;
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  .builder-controls li {
    margin-bottom: 0.5rem;
  }
</style>
