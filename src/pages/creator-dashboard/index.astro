---
import WikiLayout from '../../layouts/WikiLayout.astro';
import Badge from '../../components/ui/Badge.astro';
---

<WikiLayout title="The Entity Forge">
  <div class="forge-container">
    <header class="forge-header">
      <p class="description">Shape the reality of Lemuria. Create new mobs, characters, and locations.</p>
    </header>

    <div class="forge-form-wrapper glass-card">
      <form id="entity-form" class="forge-form">
        <div class="form-section">
          <label for="type">Entity Type</label>
          <select id="type" name="type" required>
            <option value="mob">Mob / Monster</option>
            <option value="character">NPC / Character</option>
            <option value="location">Location / Landmark</option>
          </select>
        </div>

        <div class="grid-layout">
          <div class="form-section">
            <label for="name">Name</label>
            <input type="text" id="name" name="name" placeholder="e.g. Void Stalker" required />
          </div>
          <div class="form-section">
            <label for="titles">Titles / Epithets</label>
            <input type="text" id="titles" name="titles" placeholder="e.g. The Unseen, Scourge of Ravine" />
          </div>
        </div>

        <div class="form-section">
          <label for="tags">Tags (comma separated)</label>
          <input type="text" id="tags" name="tags" placeholder="e.g. Void, Dangerous, Nocturnal" />
        </div>

        <div class="form-section">
          <label for="loreDescription">Lore & Description</label>
          <div class="textarea-container">
            <textarea id="loreDescription" name="loreDescription" placeholder="Write the history and nature of this entity..." required></textarea>
            <div id="suggestions" class="suggestions-list hidden"></div>
          </div>
        </div>

        <div class="form-section">
          <label for="image">Entity Image</label>
          <input type="file" id="image" name="image" accept="image/*" class="file-input" />
          <p class="file-hint">Images will be stored in Cloudflare R2 and served via CDN.</p>
        </div>

        <!-- Dynamic Sections -->
        <div id="mob-fields" class="dynamic-fields">
          <h3 class="section-title">Mob Attributes</h3>
          <div class="grid-layout">
            <div class="form-section">
              <label for="threatTier">Threat Tier</label>
              <select name="threatTier">
                <option value="harmless">Harmless</option>
                <option value="minor">Minor Threat</option>
                <option value="moderate">Moderate Threat</option>
                <option value="major">Major Threat</option>
                <option value="legendary">Legendary / Boss</option>
              </select>
            </div>
            <div class="form-section">
              <label for="hp">Base HP</label>
              <input type="number" name="hp" placeholder="100" />
            </div>
          </div>
          <div class="form-section">
            <label for="dropTable">Drop Table (Raw Text)</label>
            <textarea name="dropTable" placeholder="e.g. 50% Void Essence, 5% Ravine Crystal"></textarea>
          </div>
        </div>

        <div id="location-fields" class="dynamic-fields hidden">
          <h3 class="section-title">Map Data</h3>
          <div class="grid-layout">
            <div class="form-section">
              <label for="coord-x">X Coordinate</label>
              <input type="number" name="x" placeholder="0" />
            </div>
            <div class="form-section">
              <label for="coord-y">Y Coordinate</label>
              <input type="number" name="y" placeholder="0" />
            </div>
          </div>
        </div>

        <div class="form-actions">
          <button type="submit" id="submit-btn" class="submit-btn glow-hover">
            Forge Entity
          </button>
        </div>
      </form>

      <div id="status-message" class="status-message hidden"></div>
    </div>
  </div>
</WikiLayout>

<script>
  const form = document.getElementById('entity-form') as HTMLFormElement;
  const typeSelect = document.getElementById('type') as HTMLSelectElement;
  const mobFields = document.getElementById('mob-fields');
  const locationFields = document.getElementById('location-fields');
  const statusMessage = document.getElementById('status-message');
  const submitBtn = document.getElementById('submit-btn');

  const textarea = document.getElementById('loreDescription') as HTMLTextAreaElement;
  const suggestionsList = document.getElementById('suggestions');

  textarea?.addEventListener('input', async (e) => {
    const value = textarea.value;
    const cursorPosition = textarea.selectionStart;
    const textBeforeCursor = value.substring(0, cursorPosition);
    const atMatch = textBeforeCursor.match(/@(\w*)$/);

    if (atMatch && suggestionsList) {
      const query = atMatch[1];
      const response = await fetch(`/api/search-entities?q=${query}`);
      const suggestions = await response.json();

      if (suggestions.length > 0) {
        suggestionsList.innerHTML = suggestions.map((s: any) => `
          <div class="suggestion-item" data-id="${s.id}" data-name="${s.name}">
            <span class="s-name">${s.name}</span>
            <span class="s-type">${s.type}</span>
          </div>
        `).join('');
        suggestionsList.classList.remove('hidden');
      } else {
        suggestionsList.classList.add('hidden');
      }
    } else {
      suggestionsList?.classList.add('hidden');
    }
  });

  suggestionsList?.addEventListener('click', (e) => {
    const item = (e.target as HTMLElement).closest('.suggestion-item');
    if (item && textarea) {
      const id = item.getAttribute('data-id');
      const name = item.getAttribute('data-name');
      const value = textarea.value;
      const cursorPosition = textarea.selectionStart;
      const textBeforeCursor = value.substring(0, cursorPosition);
      const textAfterCursor = value.substring(cursorPosition);
      
      const newTextBefore = textBeforeCursor.replace(/@\w*$/, `[${name}](/wiki/${id})`);
      textarea.value = newTextBefore + textAfterCursor;
      suggestionsList.classList.add('hidden');
      textarea.focus();
    }
  });

  typeSelect.addEventListener('change', (e) => {
    const type = (e.target as HTMLSelectElement).value;
    mobFields?.classList.toggle('hidden', type !== 'mob');
    locationFields?.classList.toggle('hidden', type !== 'location');
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!submitBtn) return;

    submitBtn.innerText = 'Forging...';
    submitBtn.setAttribute('disabled', 'true');
    statusMessage?.classList.add('hidden');

    const formData = new FormData(form);
    const type = formData.get('type');
    
    // Construct the data payload
    const data: any = {
      type,
      name: formData.get('name'),
      titles: formData.get('titles'),
      tags: formData.get('tags'),
      loreDescription: formData.get('loreDescription'),
    };

    if (type === 'mob') {
      data.threatTier = formData.get('threatTier');
      data.baseStats = {
        hp: Number(formData.get('hp')) || 100
      };
      data.dropTable = formData.get('dropTable');
    } else if (type === 'location') {
      data.mapCoordinates = {
        x: Number(formData.get('x')) || 0,
        y: Number(formData.get('y')) || 0,
      };
    }

    // Reuse FormData to send both file and data
    const finalFormData = new FormData();
    const imageFile = formData.get('image');
    if (imageFile) finalFormData.append('image', imageFile);
    finalFormData.append('data', JSON.stringify(data));

    try {
      const response = await fetch('/api/entities', {
        method: 'POST',
        body: finalFormData,
      });

      const result = await response.json();

      if (result.success) {
        showMessage('Entity successfully forged into existence!', 'success');
        form.reset();
      } else {
        throw new Error(result.error);
      }
    } catch (err: any) {
      showMessage(`The forge failed: ${err.message}`, 'error');
    } finally {
      submitBtn.innerText = 'Forge Entity';
      submitBtn.removeAttribute('disabled');
    }
  });

  function showMessage(msg: string, type: 'success' | 'error') {
    if (!statusMessage) return;
    statusMessage.innerText = msg;
    statusMessage.className = `status-message ${type}`;
    statusMessage.classList.remove('hidden');
  }
</script>

<style>
  .forge-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .forge-header {
    margin-bottom: 2rem;
  }

  .description {
    color: var(--text-secondary);
  }

  .forge-form-wrapper {
    padding: 2.5rem;
  }

  .forge-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .form-section {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    position: relative;
  }

  .textarea-container {
    position: relative;
  }

  .suggestions-list {
    position: absolute;
    bottom: calc(100% + 5px);
    left: 0;
    width: 100%;
    max-height: 200px;
    background: var(--bg-tertiary);
    border: 1px solid var(--accent-primary);
    border-radius: 8px;
    overflow-y: auto;
    z-index: 100;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
  }

  .suggestion-item {
    padding: 0.75rem 1rem;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    transition: var(--transition-smooth);
  }

  .suggestion-item:hover {
    background: rgba(139, 92, 246, 0.2);
  }

  .s-name {
    font-weight: 600;
    color: var(--text-primary);
  }

  .s-type {
    font-size: 0.7rem;
    color: var(--text-tertiary);
    text-transform: uppercase;
  }

  .grid-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  input, select, textarea {
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    color: var(--text-primary);
    font-family: var(--font-main);
    font-size: 1rem;
    transition: var(--transition-smooth);
  }

  input:focus, select:focus, textarea:focus {
    outline: none;
    border-color: var(--accent-primary);
    box-shadow: 0 0 0 2px rgba(139, 92, 246, 0.2);
  }

  textarea {
    min-height: 120px;
    resize: vertical;
  }

  .file-input {
    padding: 0.5rem;
    border-style: dashed;
    cursor: pointer;
  }

  .file-hint {
    font-size: 0.75rem;
    color: var(--text-tertiary);
  }

  .section-title {
    font-size: 1.1rem;
    color: var(--accent-primary);
    margin: 1.5rem 0 0.5rem 0;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--glass-border);
  }

  .dynamic-fields {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    animation: fadeIn 0.3s ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .hidden {
    display: none;
  }

  .form-actions {
    margin-top: 1rem;
  }

  .submit-btn {
    width: 100%;
    padding: 1rem;
    background: var(--accent-primary);
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 1.1rem;
    font-weight: 600;
    cursor: pointer;
    transition: var(--transition-smooth);
  }

  .submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .status-message {
    margin-top: 1.5rem;
    padding: 1rem;
    border-radius: 8px;
    text-align: center;
    font-weight: 500;
  }

  .status-message.success {
    background: rgba(16, 185, 129, 0.1);
    color: #10b981;
    border: 1px solid rgba(16, 185, 129, 0.2);
  }

  .status-message.error {
    background: rgba(239, 68, 68, 0.1);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.2);
  }
</style>
