---
import { X } from '@lucide/astro';
---

<div id="lorekeeper-widget" class="chat-widget glass-card hidden">
  <div class="chat-header">
    <div class="header-info">
      <span class="status-dot"></span>
      <h3 class="chat-title">THE LOREKEEPER</h3>
    </div>
    <button id="close-chat" class="close-btn" aria-label="Close Chat">
      <X size={20} />
    </button>
  </div>
  
  <div id="chat-messages" class="chat-messages">
    <div class="message assistant">
      <span class="msg-author">CHRONICLER:</span>
      Greetings, traveler. The ancient scrolls have been unrolled. What knowledge do you seek from the history of Lemuria?
    </div>
  </div>

  <form id="chat-form" class="chat-input-area">
    <input 
      type="text" 
      id="chat-input" 
      placeholder="Type your inquiry..." 
      autocomplete="off"
    />
    <button type="submit" class="send-btn">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/>
      </svg>
    </button>
  </form>
</div>

<script>
  const widget = document.getElementById('lorekeeper-widget');
  const chatMessages = document.getElementById('chat-messages');
  const chatForm = document.getElementById('chat-form') as HTMLFormElement;
  const chatInput = document.getElementById('chat-input') as HTMLInputElement;
  const closeBtn = document.getElementById('close-chat');

  // Sliding window memory (max 10 messages)
  let chatHistory: { role: 'user' | 'assistant', content: string }[] = [];
  const MAX_HISTORY = 10;

  // Toggle Logic
  function toggleChat() {
    if (!widget) return;
    const isHidden = widget.classList.contains('hidden');
    
    if (isHidden) {
      widget.classList.remove('hidden');
      chatInput?.focus();
    } else {
      widget.classList.add('hidden');
    }
  }

  window.addEventListener('toggle-lorekeeper', toggleChat);
  closeBtn?.addEventListener('click', toggleChat);

  chatForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const query = chatInput.value.trim();
    if (!query) return;

    appendMessage('user', query);
    chatInput.value = '';

    const loadingId = 'loading-' + Date.now();
    appendMessage('assistant', 'Consulting the scrolls...', loadingId);

    try {
      const response = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          query,
          history: chatHistory
        })
      });

      const data = await response.json();
      
      const loadingEl = document.getElementById(loadingId);
      if (loadingEl) loadingEl.remove();

      if (data.response) {
        appendMessage('assistant', data.response);
        chatHistory.push({ role: 'user', content: query });
        chatHistory.push({ role: 'assistant', content: data.response });
        
        if (chatHistory.length > MAX_HISTORY) {
          chatHistory = chatHistory.slice(chatHistory.length - MAX_HISTORY);
        }
      }
    } catch (err) {
      const loadingEl = document.getElementById(loadingId);
      if (loadingEl) loadingEl.remove();
      appendMessage('assistant', 'The connection to the archives has been severed.');
    }
  });

  function appendMessage(role: 'user' | 'assistant', text: string, id?: string) {
    if (!chatMessages) return;
    const div = document.createElement('div');
    div.className = `message ${role}`;
    if (id) div.id = id;
    
    if (role === 'assistant') {
      const author = document.createElement('span');
      author.className = 'msg-author';
      author.innerText = 'CHRONICLER: ';
      div.appendChild(author);
      const content = document.createTextNode(text);
      div.appendChild(content);
    } else {
      div.innerText = text;
    }

    chatMessages.appendChild(div);
    chatMessages.scrollTop = chatMessages.scrollHeight;
  }
</script>

<style>
  .chat-widget {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    width: 420px;
    height: 600px;
    display: flex;
    flex-direction: column;
    z-index: 1000;
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.6);
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
    background: rgba(15, 12, 26, 0.95);
    backdrop-filter: blur(20px);
    border: 1px solid var(--glass-border);
    border-radius: 24px;
  }

  .chat-widget.hidden {
    transform: translateY(20px) scale(0.95);
    opacity: 0;
    pointer-events: none;
  }

  .chat-header {
    padding: 1.5rem;
    background: rgba(139, 92, 246, 0.1);
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--glass-border);
  }

  .header-info {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    background: #10b981;
    border-radius: 50%;
    box-shadow: 0 0 10px #10b981;
  }

  .chat-title {
    font-size: 0.85rem;
    letter-spacing: 0.15em;
    font-weight: 700;
    color: var(--accent-primary);
  }

  .close-btn {
    background: none;
    border: none;
    color: var(--text-tertiary);
    cursor: pointer;
    font-size: 1.2rem;
    padding: 0.5rem;
    transition: color 0.3s ease;
  }

  .close-btn:hover {
    color: var(--text-primary);
  }

  .chat-messages {
    flex: 1;
    padding: 2rem;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .message {
    padding: 1rem 1.2rem;
    border-radius: 16px;
    max-width: 85%;
    font-size: 0.95rem;
    line-height: 1.6;
    animation: slideUp 0.3s ease-out;
  }

  @keyframes slideUp {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .message.user {
    align-self: flex-end;
    background: var(--accent-primary);
    color: white;
    border-bottom-right-radius: 2px;
  }

  .message.assistant {
    align-self: flex-start;
    background: rgba(212, 175, 55, 0.05);
    color: var(--text-primary);
    border-bottom-left-radius: 2px;
    border: 1px solid var(--accent-glow);
  }

  .msg-author {
    display: block;
    font-size: 0.7rem;
    font-weight: 800;
    color: var(--accent-primary);
    margin-bottom: 0.25rem;
    letter-spacing: 0.1em;
  }

  .chat-input-area {
    padding: 1.5rem;
    background: rgba(0, 0, 0, 0.2);
    display: flex;
    gap: 0.75rem;
    border-top: 1px solid var(--glass-border);
  }

  #chat-input {
    flex: 1;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--glass-border);
    border-radius: 12px;
    padding: 0.8rem 1.2rem;
    color: var(--text-primary);
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.3s ease;
  }

  #chat-input:focus {
    border-color: var(--accent-primary);
  }

  .send-btn {
    background: var(--accent-primary);
    border: none;
    color: white;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    transition: all 0.3s ease;
  }

  .send-btn:hover {
    transform: scale(1.05);
    box-shadow: 0 0 20px rgba(139, 92, 246, 0.4);
  }

  @media (max-width: 480px) {
    .chat-widget {
      width: calc(100vw - 2rem);
      height: 80vh;
      right: 1rem;
      bottom: 1rem;
    }
  }
</style>
