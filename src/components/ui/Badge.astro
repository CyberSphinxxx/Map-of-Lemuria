---
interface Props {
  variant?: 'primary' | 'secondary' | 'accent' | 'outline';
  class?: string;
}

const { variant = 'primary', class: className } = Astro.props;

// Styles are handled in the style block below.
---

<span class:list={['badge', variant, className]}>
  <slot />
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.025em;
    border: 1px solid transparent;
    transition: var(--transition-smooth);
    white-space: nowrap;
  }

  .primary {
    background: var(--bg-tertiary);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
  }

  .secondary {
    background: rgba(181, 172, 154, 0.05);
    color: var(--text-secondary);
    border: 1px solid rgba(181, 172, 154, 0.1);
  }

  .accent {
    background: rgba(212, 175, 55, 0.1);
    color: var(--accent-primary);
    border: 1px solid rgba(212, 175, 55, 0.2);
  }

  .outline {
    background: transparent;
    color: var(--text-secondary);
    border: 1px solid var(--border-color);
  }

  .badge:hover {
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }
</style>
