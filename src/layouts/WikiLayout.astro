---
import '../styles/global.css';
import LorekeeperChat from '../components/LorekeeperChat.astro';
import { Flame, Compass, User, Swords, Coins, Scroll, BookOpen, Settings as SettingsIcon } from '@lucide/astro';
import { t, type LanguageStyle } from '../lib/i18n';

interface Props {
  title: string;
  description?: string;
  category?: string;
}

const { title, description = "Discover the secrets of Lemuria.", category } = Astro.props;
const style = (Astro.locals.languageStyle as LanguageStyle) || 'fantasy';
console.log('[WikiLayout] Current style:', style);
const strings = t(style);

// Navigation links
const navLinks = [
  { name: strings.nav.home, href: '/' },
  { name: strings.nav.world, href: '/world' },
  { name: strings.nav.characters, href: '/characters' },
  { name: strings.nav.mobs, href: '/mobs' },
  { name: strings.nav.items, href: '/items' },
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Lemuria</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Inter:wght@400;500;600;700&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="dark-theme">
    <div class="app-container">
      <!-- Top Navigation -->
      <header class="top-nav">
        <div class="nav-left">
          <a href="/" class="logo glow-text">LEMURIA</a>
          <nav class="desktop-nav">
            {navLinks.map(link => (
              <a href={link.href} class="nav-item">{link.name}</a>
            ))}
          </nav>
        </div>

        <div class="nav-right">
          <button id="theme-toggle" class="icon-btn" aria-label="Toggle Theme">
            <Flame size={20} />
          </button>
          <a href="/settings" class="icon-btn" aria-label="Settings">
            <SettingsIcon size={20} />
          </a>
          {Astro.locals.user ? (
            <div class="user-actions">
              <a href="/creator-dashboard" class="forge-btn">{strings.nav.forge}</a>
              <button id="nav-sign-out-btn" class="sign-out-btn">{strings.nav.logout}</button>
            </div>
          ) : (
            <a href="/login" class="login-btn">{strings.nav.login}</a>
          )}
        </div>
      </header>

      <div class="main-content-layout">
        <!-- Persistent Sidebar -->
        <aside class="sidebar">
          <div class="sidebar-section">
            <h3 class="section-title">{strings.sidebar.archives}</h3>
            <nav class="side-nav">
              <a href="/world" class:list={['side-item', { active: category === 'World' }]}>
                <Compass size={18} /> <span>{strings.sidebar.world}</span>
              </a>
              <a href="/characters" class:list={['side-item', { active: category === 'Characters' }]}>
                <User size={18} /> <span>{strings.sidebar.characters}</span>
              </a>
              <a href="/mobs" class:list={['side-item', { active: category === 'Bestiary' }]}>
                <Swords size={18} /> <span>{strings.sidebar.mobs}</span>
              </a>
              <a href="/items" class:list={['side-item', { active: category === 'Artifacts' }]}>
                <Coins size={18} /> <span>{strings.sidebar.items}</span>
              </a>
            </nav>
          </div>

          <div class="sidebar-section">
            <h3 class="section-title">{strings.sidebar.chronicles}</h3>
            <nav class="side-nav">
              <a href="/rules" class="side-item"><Scroll size={18} /> <span>{strings.sidebar.rules}</span></a>
              <a href="/about" class="side-item"><BookOpen size={18} /> <span>{strings.sidebar.about}</span></a>
            </nav>
          </div>
        </aside>

        <!-- Dynamic Content Area -->
        <main class="page-content">
          <slot />
        </main>
      </div>

      <LorekeeperChat />
    </div>

    <script is:inline>
      // Simple Logout Integration
      const signOutBtn = document.getElementById('nav-sign-out-btn');
      if (signOutBtn) {
        signOutBtn.addEventListener('click', async () => {
          signOutBtn.textContent = 'SEALING...';
          await fetch('/api/logout', { method: 'POST' });
          window.location.href = '/login';
        });
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --accent-primary: #8b5cf6;
    --accent-glow: rgba(139, 92, 246, 0.4);
    --bg-dark: #0a0a0c;
    --bg-card: #141418;
    --text-primary: #ffffff;
    --text-secondary: #a1a1aa;
    --border-color: rgba(255, 255, 255, 0.1);
    --font-display: 'Cinzel', serif;
    --font-main: 'Outfit', sans-serif;
  }

  body {
    margin: 0;
    padding: 0;
    background: var(--bg-dark);
    color: var(--text-primary);
    font-family: var(--font-main);
    overflow-x: hidden;
  }

  .glow-text {
    font-family: var(--font-display);
    text-shadow: 0 0 10px var(--accent-glow);
    letter-spacing: 0.1em;
  }

  .top-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 2rem;
    height: 64px;
    background: rgba(10, 10, 12, 0.9);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-color);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .nav-left { display: flex; align-items: center; gap: 3rem; }
  .logo { font-size: 1.5rem; text-decoration: none; font-weight: 700; color: white; }
  .desktop-nav { display: flex; gap: 1.5rem; }
  .nav-item { text-decoration: none; color: var(--text-secondary); font-weight: 500; font-size: 0.9rem; transition: 0.2s; }
  .nav-item:hover { color: white; text-shadow: 0 0 8px var(--accent-glow); }

  .nav-right { display: flex; align-items: center; gap: 1rem; }
  .icon-btn { background: none; border: none; color: var(--text-secondary); cursor: pointer; transition: 0.2s; padding: 0.5rem; border-radius: 8px; }
  .icon-btn:hover { background: rgba(255,255,255,0.05); color: var(--accent-primary); }

  .login-btn, .forge-btn {
    padding: 0.6rem 1.2rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.85rem;
    transition: 0.3s;
  }
  .login-btn { border: 1px solid var(--accent-primary); color: var(--accent-primary); }
  .forge-btn { background: var(--accent-primary); color: white; }

  .main-content-layout { display: flex; min-height: calc(100vh - 65px); }
  .sidebar { width: 280px; border-right: 1px solid var(--border-color); padding: 2rem; background: rgba(0,0,0,0.2); }
  .section-title { font-size: 0.75rem; text-transform: uppercase; color: var(--text-secondary); letter-spacing: 0.1em; margin-bottom: 1rem; }
  .side-nav { display: flex; flex-direction: column; gap: 0.5rem; }
  .side-item { display: flex; align-items: center; gap: 1rem; padding: 0.75rem 1rem; border-radius: 10px; color: var(--text-secondary); text-decoration: none; transition: 0.2s; }
  .side-item:hover, .side-item.active { background: rgba(139, 92, 246, 0.1); color: var(--accent-primary); }

  .page-content { flex: 1; padding: 3rem; max-width: 1200px; margin: 0 auto; }
</style>
