---
import '../styles/global.css';
import LorekeeperChat from '../components/LorekeeperChat.astro';
import { Flame, Compass, User, Swords, Coins, Scroll, BookOpen, Map as MapIcon } from '@lucide/astro';

interface Props {
  title: string;
  description?: string;
  category?: string;
}

const { title, description = "Discover the secrets of Lemuria.", category } = Astro.props;

// Navigation links
const navLinks = [
  { name: 'Home', href: '/' },
  { name: 'World', href: '/world' },
  { name: 'Characters', href: '/characters' },
  { name: 'Bestiary', href: '/mobs' },
  { name: 'Artifacts', href: '/items' },
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Map of Lemuria</title>
    <meta name="description" content={description} />
    <!-- Preload fonts if available -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body>
    <div class="app-container">
      <!-- Persistent Top Navigation -->
      <header class="top-nav glass-card">
        <div class="nav-brand">
          <a href="/" class="logo">LEMURIA</a>
        </div>
        
        <nav class="desktop-nav">
          {navLinks.map(link => (
            <a href={link.href} class={`nav-item ${Astro.url.pathname === link.href ? 'active' : ''}`}>
              {link.name}
            </a>
          ))}
        </nav>

        <div class="search-container">
          <div class="ai-search-bar" id="global-search-trigger">
            <span class="search-icon"><Flame size={18} /></span>
            <input type="text" placeholder="Seek ancient knowledge..." readonly />
            <kbd class="search-hint">⌘K</kbd>
          </div>
        </div>

        <div class="nav-actions">
          <a href="/creator-dashboard" class="forge-link">THE FORGE</a>
        </div>
      </header>

      <div class="main-layout">
        <!-- Responsive Sidebar -->
        <aside class="sidebar">
          <div class="sidebar-sticky">
            <div class="sidebar-section">
              <h4 class="section-label">Current Archives</h4>
              <nav class="category-nav">
                <a href="/world" class={`cat-link ${category === 'World' ? 'active' : ''}`}>
                  <span class="icon"><Compass size={20} /></span> Territories of the Realm
                </a>
                <a href="/characters" class={`cat-link ${category === 'Characters' ? 'active' : ''}`}>
                  <span class="icon"><User size={20} /></span> Inhabitants of Note
                </a>
                <a href="/mobs" class={`cat-link ${category === 'Bestiary' ? 'active' : ''}`}>
                  <span class="icon"><Swords size={20} /></span> The Ancient Bestiary
                </a>
                <a href="/items" class={`cat-link ${category === 'Artifacts' ? 'active' : ''}`}>
                  <span class="icon"><Coins size={20} /></span> Relics & Treasures
                </a>
              </nav>
            </div>

            <div class="sidebar-section">
              <h4 class="section-label">Quick Links</h4>
              <nav class="category-nav">
                <a href="/rules" class="cat-link"><Scroll size={18} /> World Systems</a>
                <a href="/about" class="cat-link"><BookOpen size={18} /> Project Lore</a>
              </nav>
            </div>
          </div>
        </aside>

        <!-- Main Content Area -->
        <main class="content-wrapper">
          <div class="prose-container">
            <header class="page-header">
              <div class="breadcrumb">
                {category && <span>{category} / </span>}
                <span class="current">{title}</span>
              </div>
              <h1 class="glow-text">{title}</h1>
            </header>
            
            <div class="page-body">
              <slot />
            </div>
          </div>
        </main>
      </div>
    </div>

    <!-- Lorekeeper Chat Integration -->
    <LorekeeperChat />

    <style is:global>
      :root {
        --nav-height: 80px;
        --sidebar-width: 300px;
      }

      .app-container {
        min-height: 100vh;
        background: radial-gradient(circle at 50% -20%, #1a1625 0%, #0f0c1a 100%);
        color: var(--text-primary);
      }

      /* Top Nav Styling */
      .top-nav {
        height: var(--nav-height);
        width: 100%;
        position: fixed;
        top: 0;
        left: 0;
        z-index: 100;
        display: flex;
        align-items: center;
        padding: 0 2rem;
        gap: 2rem;
        border-radius: 0;
        border-top: none;
        border-left: none;
        border-right: none;
        background: rgba(15, 12, 26, 0.8);
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.3);
      }

      .logo {
        font-family: var(--font-display);
        font-size: 1.5rem;
        letter-spacing: 0.2em;
        color: var(--accent-primary);
        text-decoration: none;
        font-weight: 700;
        text-shadow: 0 0 15px rgba(139, 92, 246, 0.3);
      }

      .desktop-nav {
        display: flex;
        gap: 1.5rem;
      }

      .nav-item {
        color: var(--text-secondary);
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        transition: var(--transition-smooth);
        padding: 0.5rem 0;
        position: relative;
      }

      .nav-item:hover, .nav-item.active {
        color: var(--text-primary);
      }

      .nav-item.active::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 2px;
        background: var(--accent-primary);
        box-shadow: 0 0 10px var(--accent-primary);
      }

      .search-container {
        flex: 1;
        max-width: 500px;
        margin: 0 2rem;
      }

      .ai-search-bar {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid var(--glass-border);
        padding: 0.6rem 1.2rem;
        border-radius: 12px;
        cursor: pointer;
        transition: var(--transition-smooth);
      }

      .ai-search-bar:hover {
        background: rgba(255, 255, 255, 0.08);
        border-color: rgba(139, 92, 246, 0.5);
      }

      .ai-search-bar input {
        background: none;
        border: none;
        color: var(--text-secondary);
        font-size: 0.9rem;
        outline: none;
        width: 100%;
        cursor: pointer;
      }

      .search-hint {
        font-size: 0.7rem;
        background: rgba(255, 255, 255, 0.1);
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        color: var(--text-tertiary);
        border: 1px solid var(--glass-border);
      }

      .forge-link {
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--accent-primary);
        text-decoration: none;
        border: 1px solid var(--accent-primary);
        padding: 0.5rem 1rem;
        border-radius: 8px;
        transition: var(--transition-smooth);
      }

      .forge-link:hover {
        background: var(--accent-primary);
        color: white;
        box-shadow: 0 0 20px rgba(139, 92, 246, 0.4);
      }

      /* Main Layout Styling */
      .main-layout {
        display: flex;
        padding-top: var(--nav-height);
        max-width: 1800px;
        margin: 0 auto;
      }

      .sidebar {
        width: var(--sidebar-width);
        padding: 3rem 2rem;
        border-right: 1px solid var(--glass-border);
      }

      .sidebar-sticky {
        position: sticky;
        top: calc(var(--nav-height) + 2rem);
      }

      .sidebar-section {
        margin-bottom: 3rem;
      }

      .section-label {
        font-size: 0.7rem;
        color: var(--text-tertiary);
        text-transform: uppercase;
        letter-spacing: 0.2em;
        margin-bottom: 1.5rem;
      }

      .category-nav {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }

      .cat-link {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.75rem 1rem;
        color: var(--text-secondary);
        text-decoration: none;
        border-radius: 10px;
        transition: var(--transition-smooth);
        font-size: 0.95rem;
      }

      .cat-link:hover {
        background: rgba(255, 255, 255, 0.03);
        color: var(--text-primary);
        transform: translateX(5px);
      }

      .cat-link.active {
        background: rgba(139, 92, 246, 0.1);
        color: var(--accent-primary);
        font-weight: 600;
      }

      .cat-link .icon {
        font-size: 1.2rem;
      }

      /* Content Wrapper Styling */
      .content-wrapper {
        flex: 1;
        padding: 4rem;
        min-width: 0;
      }

      .prose-container {
        max-width: 1000px;
        margin: 0 auto;
      }

      .page-header {
        margin-bottom: 4rem;
      }

      .breadcrumb {
        font-size: 0.8rem;
        color: var(--text-tertiary);
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-bottom: 1rem;
      }

      .breadcrumb .current {
        color: var(--accent-primary);
      }

      .page-header h1 {
        font-size: 4rem;
        margin: 0;
        line-height: 1.1;
      }

      .page-body {
        font-size: 1.15rem;
        line-height: 1.8;
        color: var(--text-secondary);
      }

      @media (max-width: 1280px) {
        .sidebar {
          display: none;
        }
        .content-wrapper {
          padding: 3rem 2rem;
        }
      }

      @media (max-width: 1024px) {
        .desktop-nav, .search-container {
          display: none;
        }
        .page-header h1 {
          font-size: 3rem;
        }
      }
    </style>

    <script>
      // Global Search Implementation
      document.getElementById('global-search-trigger')?.addEventListener('click', () => {
        // Trigger the Lorekeeper Chat
        window.dispatchEvent(new CustomEvent('toggle-lorekeeper'));
      });

      // Keyboard shortcut ⌘K
      window.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
          e.preventDefault();
          window.dispatchEvent(new CustomEvent('toggle-lorekeeper'));
        }
      });
    </script>
  </body>
</html>
